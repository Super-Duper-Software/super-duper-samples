# Copy to .dev.vars (git-ignored) for `wrangler dev`.
# .dev.vars supplies secrets locally; in production this is a Worker secret set
# with `wrangler secret put FREESOUND_CLIENT_SECRET`.

FREESOUND_CLIENT_SECRET=your-freesound-client-secret

# Optional local overrides of the wrangler.toml [vars] values:
# FREESOUND_CLIENT_ID=your-freesound-client-id
# ALLOWED_ORIGINS=
# ALLOWED_USER_AGENTS=
# RATE_LIMIT_PER_MINUTE=30
