# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# Freesound token auth — used for search and Preview playback (no OAuth).
# Apply for a key at https://freesound.org/apiv2/apply/
FREESOUND_API_KEY=

# OAuth authorization-code grant, public part. Used from ticket 07 onward.
FREESOUND_CLIENT_ID=

# Deployed ticket-06 token-exchange Worker base URL. Used from ticket 07 onward.
FREESOUND_TOKEN_WORKER_URL=
