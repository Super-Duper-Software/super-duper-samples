# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# OAuth authorization-code grant, public part. Safe to ship in the client (it is
# not a secret). REQUIRED: the app bundles no API key (ADR-0004 — the Freesound
# API key IS client_secret), so every Freesound call, search included, uses the
# signed-in user's OAuth token. No sign-in => no search.
# Apply for a credential at https://freesound.org/apiv2/apply/
FREESOUND_CLIENT_ID=

# Deployed ticket-06 token-exchange Worker base URL, e.g.
# https://freesound-token-worker.<subdomain>.workers.dev
# The Worker holds client_secret and performs the code<->token exchanges.
FREESOUND_TOKEN_WORKER_URL=

# NOTE: there is deliberately NO FREESOUND_CLIENT_SECRET here. The desktop app is
# a public client (ADR-0004) and must never hold the secret — it lives ONLY in
# the Cloudflare Worker, set with `wrangler secret put FREESOUND_CLIENT_SECRET`.

# Anonymous monthly-active-user count. On by default: a random per-install UUID
# (stored in <userData>/install-id, never anything personal) is sent to the token
# Worker on sign-in and token refresh, which records only a salted hash of it.
# Set to 0 / false / off / no to send nothing.
SDS_TELEMETRY=
