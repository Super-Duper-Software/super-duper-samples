# Copy to `.env` (git-ignored) and fill in. Never commit real values.

# OAuth authorization-code grant, public part. Safe to ship in the client (it is
# not a secret). REQUIRED: the app bundles no API key (the Freesound
# API key IS client_secret), so every Freesound call, search included, uses the
# signed-in user's OAuth token. No sign-in => no search.
# Apply for a credential at https://freesound.org/apiv2/apply/
FREESOUND_CLIENT_ID=

# Deployed ticket-06 token-exchange Worker base URL, e.g.
# https://freesound-token-worker.<subdomain>.workers.dev
# The Worker holds client_secret and performs the code<->token exchanges.
FREESOUND_TOKEN_WORKER_URL=

# NOTE: there is deliberately NO FREESOUND_CLIENT_SECRET here. The desktop app is
# a public client and must never hold the secret — it lives ONLY in
# the Cloudflare Worker, set with `wrangler secret put FREESOUND_CLIENT_SECRET`.

# Anonymous telemetry. On by default, and only recorded if the Worker operator
# opts in (see worker/README.md). Two things, both anonymous:
#   1. Monthly-active-user count — a random per-install UUID (stored in
#      <userData>/install-id, nothing personal) sent on sign-in / token refresh;
#      the Worker keeps only a salted hash.
#   2. Error-category counts — POSTed to the Worker's /report every few minutes:
#      app version, OS, a fixed error kind, and a count. No message, path, query,
#      URL, or identifier.
# Set to 0 / false / off / no to disable both.
SDS_TELEMETRY=
